
# Q1: BFS for Smart City Emergency Evacuation System

from collections import deque


def find_nearest_center(roads, start, evacuation_centers):
    """Find the nearest evacuation center using BFS."""

    if start not in roads:
        return None, None

    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        current, path = queue.popleft()

        # Check whether the current location is an evacuation center
        if current in evacuation_centers:
            return current, path

        # Explore all connected roads
        for neighbor in roads.get(current, []):
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append((neighbor, path + [neighbor]))

    # No evacuation center is reachable
    return None, None


